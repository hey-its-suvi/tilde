-- Constraints: the ergonomic surface over `core`.
--
-- Each returns its subject so statements chain left to right:
--     line l parallel m through p
-- groups as ((line l parallel m) through p).
--
-- All composed, no tsx. The declaring forms (`line l parallel m`) are written
-- out by hand rather than derived: whether a definition constrains its subject
-- or produces a new element is a property of the body, not the signature, so
-- there is nothing reliable to derive from.

import core

-- ─── Relations between lines ────────────────────────────────────────────────

define (a: Line) perpendicular (b: Line) at (p: Point) => Line:
    a perpendicular b
    p on a
    p on b
    return a

-- ─── Incidence ──────────────────────────────────────────────────────────────

define (l: Line) through (p: Point) => Line:
    p on l
    return l

-- ─── Declaring forms ────────────────────────────────────────────────────────

define line (n: Name) parallel (m: Line) => Line:
    line n
    n parallel m
    return n

define line (n: Name) perpendicular (m: Line) => Line:
    line n
    n perpendicular m
    return n

define point (n: Name) on (l: Line) => Point:
    point n
    n on l
    return n

define point (n: Name) on (c: Circle) => Point:
    point n
    n on c
    return n
