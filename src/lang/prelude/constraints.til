-- Constraints.
--
-- Each returns its subject so statements chain left to right:
--     line l parallel m through p
-- groups as ((line l parallel m) through p).
--
-- A tsx`...` body is TypeScript, run when the statement is evaluated. Slots are
-- in scope by name; `constrain` adds a constraint the solver understands, and
-- the body's return value is the definition's result. Anything without a tsx
-- body is composed from other definitions — most of this file, and all a user
-- can write today.

-- ─── Relations between lines ────────────────────────────────────────────────

define (a: Line) parallel (b: Line) => Line =
    tsx`
    constrain({ kind: 'parallel', l1: a, l2: b })
    return a
    `

define (a: Line) parallel (b: Line) at (d: Scalar) => Line =
    tsx`
    constrain({ kind: 'parallel', l1: a, l2: b, distance: d })
    return a
    `

define (a: Line) perpendicular (b: Line) => Line =
    tsx`
    constrain({ kind: 'perpendicular', l1: a, l2: b })
    return a
    `

-- Composed: the `at` variant is the plain one plus two incidences.
define (a: Line) perpendicular (b: Line) at (p: Point) => Line =
    a perpendicular b
    p on a
    p on b

-- ─── Incidence ──────────────────────────────────────────────────────────────

define (p: Point) on (l: Line) => Point =
    tsx`
    constrain({ kind: 'on-line', point: p, line: l })
    return p
    `

define (p: Point) on (c: Circle) => Point =
    tsx`
    constrain({ kind: 'on-circle', point: p, circle: c })
    return p
    `

define (l: Line) through (p: Point) => Line =
    p on l

-- ─── Measurement ────────────────────────────────────────────────────────────
-- Distance is a constraint, not a value: the solver stores a length for a pair
-- of points, and has no way to hand a measurement back as a scalar. So this
-- form takes the length rather than returning it, and returns nothing.
-- `distance between p and q` as a *value* waits on the accessor work.

define distance between (p: Point) and (q: Point) is (d: Scalar) =
    tsx`
    segment(p, q)
    constrain({ kind: 'distance', p1: p, p2: q, value: d })
    `

-- ─── Declaring forms ────────────────────────────────────────────────────────
-- Written out by hand rather than derived. All composed — no tsx needed.

define line (n: Name) parallel (m: Line) => Line =
    line n
    n parallel m

define line (n: Name) perpendicular (m: Line) => Line =
    line n
    n perpendicular m

define point (n: Name) on (l: Line) => Point =
    point n
    n on l

define point (n: Name) on (c: Circle) => Point =
    point n
    n on c
