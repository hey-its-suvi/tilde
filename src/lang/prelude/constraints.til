-- Constraints: the ergonomic surface over `core`.
--
-- Each returns its subject so statements chain left to right:
--     line l parallel m through p
-- reads as ((line l) parallel m) through p — `line l` makes the line, and
-- everything after it is said about the line it made (decision 19). So there
-- are no declaring forms here: `line l parallel m` needs no definition of its
-- own, and anyone wanting a different one can write it and win by being longer.
--
-- All composed, no tsx.

import core

-- ─── Relations between lines ────────────────────────────────────────────────

define (a: Line) perpendicular (b: Line) at (p: Point) => Line:
    a perpendicular b
    p on a
    p on b
    return a

-- ─── Equality ───────────────────────────────────────────────────────────────
-- `n.a = p`: the two points are the same point. For now that is said as a
-- constraint — two points held at no distance apart — not one point under two
-- names: they are still two points, drawn on top of each other. When `=` can
-- merge two elements into one, this becomes a merge (decision 18).

define (p: Point) = (q: Point):
    distance between p and q is 0

-- ─── Incidence ──────────────────────────────────────────────────────────────

define (l: Line) through (p: Point) => Line:
    p on l
    return l
