-- The prelude. Not special — a program gets it by writing `import prelude`,
-- the same way it would import anything else. Nothing auto-imports it, so
-- dropping or replacing it later costs nothing.
--
-- `export import` rather than `import`: imports are file-scoped and do not
-- transit, so a barrel has to pass on what it collects. Plain `import` here
-- would make these usable inside this file and invisible to anyone importing
-- it — which, given this file defines nothing, would export nothing at all.
--
-- `core` is re-exported alongside the rest: its primitives (`p at 3 5`,
-- `l parallel m`, `p on l`) are the everyday surface, not internals.

export import core
export import shapes
export import constraints
