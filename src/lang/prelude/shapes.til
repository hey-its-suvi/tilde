-- Shape declarations: the ergonomic surface over `core`.
--
-- Every definition here is composed — no tsx, nothing a user could not have
-- written. That is the check on the whole design: if the convenient forms need
-- a hatch, the primitives are wrong.

import core

-- ─── Points ─────────────────────────────────────────────────────────────────

define point (n: Name) at (x: Scalar) (y: Scalar) => Point =
    point n
    n at x y

-- ─── Lines ──────────────────────────────────────────────────────────────────

define line (n: Name) through (p: Point) (q: Point) => Line =
    line n
    p on n
    q on n

-- ─── Circles ────────────────────────────────────────────────────────────────

define circle (n: Name) with center (p: Point) => Circle =
    circle n
    n with center p

define circle (n: Name) with radius (r: Scalar) => Circle =
    circle n
    n with radius r

define circle (n: Name) with center (p: Point) and radius (r: Scalar) => Circle =
    circle n with center p
    n with radius r

-- ─── Composites ─────────────────────────────────────────────────────────────
-- Note `with`, not juxtaposition: `triangle a, b, c` distributes into three
-- separate triangles, so the multi-vertex form must be lexically distinct.

define triangle (t: Name) with (a: Name) (b: Name) (c: Name) => Triangle =
    point a
    point b
    point c
    t holds a b c
