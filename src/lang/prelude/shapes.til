-- Shape declarations: the ergonomic surface over `core`.
--
-- Every definition here is composed — no tsx, nothing a user could not have
-- written. That is the check on the whole design: if the convenient forms need
-- a hatch, the primitives are wrong.
--
-- `return` says which of the things built above comes back. It is the last line
-- of a body, and body order otherwise does not matter.

import core

-- ─── Points ─────────────────────────────────────────────────────────────────

define point (n: Name) at (x: Scalar) (y: Scalar) => Point =
    point n
    n at x y
    return n

-- ─── Lines ──────────────────────────────────────────────────────────────────

define line (n: Name) through (p: Point) (q: Point) => Line =
    line n
    p on n
    q on n
    return n

-- ─── Circles ────────────────────────────────────────────────────────────────

define circle (n: Name) with center (p: Point) => Circle =
    circle n
    n with center p
    return n

define circle (n: Name) with radius (r: Scalar) => Circle =
    circle n
    n with radius r
    return n

define circle (n: Name) with center (p: Point) and radius (r: Scalar) => Circle =
    circle n with center p
    n with radius r
    return n

-- ─── Composites ─────────────────────────────────────────────────────────────
-- Triangle lives here rather than in `core` because the solver knows nothing
-- about it: it is three points and the edges between them. Nothing below uses
-- the tsx hatch — `new`, `call` and `segment` are all the machinery a composite
-- needs, so a user could write this file.
--
-- A field holds a reference to a *whole* element, never a piece of one. `Point a`
-- is declarable and `Scalar x` inside Point is not: a line's two tangent
-- solutions live in the line as a whole, and splitting it into three scalars
-- would turn two real answers into eight candidates.

-- Fields are numbered rather than lettered so the naming carries to shapes with
-- more corners: a quadrilateral's `point4` reads the same way, where `d` would
-- have run out of alphabet and out of convention.

define type Triangle =
    Point point1
    Point point2
    Point point3

-- `new Triangle t` makes the triangle and its three points, named t.a, t.b, t.c.
-- `call` then hands each one the name the caller asked for, so `a` and `t.a` are
-- two names for one point rather than two points kept in step.
--
-- Note `with`, not juxtaposition: `triangle a, b, c` distributes into three
-- separate triangles, so the multi-vertex form must be lexically distinct.

define triangle (t: Name) with (a: Name) (b: Name) (c: Name) => Triangle =
    new Triangle t
    call t.point1 a
    call t.point2 b
    call t.point3 c
    segment a b
    segment b c
    segment c a
    return t
