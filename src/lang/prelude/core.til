-- The primitive surface: every definition the solver backs directly.
--
-- A tsx`...` body is TypeScript, run when the statement is evaluated. Slots are
-- in scope by name, and the API is three calls: `declare(name, type)` registers
-- a name, `constrain(c)` adds a constraint the solver understands, `segment(a, b)`
-- records a segment. The body's return value is the definition's result.
--
-- These are the only definitions that reach into the solver. Everything else in
-- the prelude composes from them, using nothing a user could not use — which is
-- the whole point. This file is where that stops being true, so it is kept
-- small and separate.
--
-- `point`, `line`, `circle` are not keywords. They are ordinary words in a
-- pattern, and these definitions are what give them meaning.

-- ─── Elements ───────────────────────────────────────────────────────────────

define point (n: Name) => Point =
    tsx`
    return declare(n, 'Point')
    `

define line (n: Name) => Line =
    tsx`
    return declare(n, 'Line')
    `

define circle (n: Name) => Circle =
    tsx`
    return declare(n, 'Circle')
    `

-- ─── Scalars ────────────────────────────────────────────────────────────────
-- A named number. Its value may be given, or left for the solver to work out
-- from everything else — `scalar r` with nothing else says only that some number
-- exists, which is enough to tie two shapes to the same size.

define scalar (n: Name) => Scalar =
    tsx`
    return declare(n, 'Scalar')
    `

define scalar (n: Name) is (v: Scalar) => Scalar =
    scalar n
    n is v
    return n

-- `is` takes a number written down or another named number. Two names are made
-- the *same* number rather than one copied into the other: each is narrowed to
-- what both could be, so it does not matter which becomes known first.

define (s: Scalar) is (v: Scalar) => Scalar =
    tsx`
    if (typeof v === 'number') {
        constrain({ kind: 'scalar-equality', scalar: s, target: v })
    } else {
        constrain({ kind: 'scalars-equal', a: s, b: v })
    }
    return s
    `

-- ─── Placement ──────────────────────────────────────────────────────────────
-- A Scalar slot takes either a number written down or a named scalar, and the
-- two mean the same thing: this dimension is that number. A literal can go
-- straight into the constraint; a name has to be tied to the field instead, so
-- the solver can work in whichever direction it ends up knowing first.

define (p: Point) at (x: Scalar) (y: Scalar) => Point =
    tsx`
    constrain({ kind: 'position', point: p,
        x: typeof x === 'number' ? x : null,
        y: typeof y === 'number' ? y : null,
    })
    if (typeof x === 'string') {
        constrain({ kind: 'scalar-equality', scalar: x, target: { element: p, field: 'x' } })
    }
    if (typeof y === 'string') {
        constrain({ kind: 'scalar-equality', scalar: y, target: { element: p, field: 'y' } })
    }
    return p
    `

define (c: Circle) with center (p: Point) => Circle =
    tsx`
    constrain({ kind: 'circle-spec', circle: c, center: p, r: null })
    return c
    `

define (c: Circle) with radius (r: Scalar) => Circle =
    tsx`
    if (typeof r === 'number') {
        constrain({ kind: 'circle-spec', circle: c, center: null, r })
    } else {
        constrain({ kind: 'circle-spec', circle: c, center: null, r: null })
        constrain({ kind: 'scalar-equality', scalar: r, target: { element: c, field: 'r' } })
    }
    return c
    `

-- ─── Relations between lines ────────────────────────────────────────────────

define (a: Line) parallel (b: Line) => Line =
    tsx`
    constrain({ kind: 'parallel', l1: a, l2: b })
    return a
    `

define (a: Line) parallel (b: Line) at (d: Scalar) => Line =
    tsx`
    constrain({ kind: 'parallel', l1: a, l2: b, distance: d })
    return a
    `

define (a: Line) perpendicular (b: Line) => Line =
    tsx`
    constrain({ kind: 'perpendicular', l1: a, l2: b })
    return a
    `

-- ─── Incidence ──────────────────────────────────────────────────────────────

define (p: Point) on (l: Line) => Point =
    tsx`
    constrain({ kind: 'on-line', point: p, line: l })
    return p
    `

define (p: Point) on (c: Circle) => Point =
    tsx`
    constrain({ kind: 'on-circle', point: p, circle: c })
    return p
    `

-- ─── Measurement ────────────────────────────────────────────────────────────
-- Distance is a constraint, not a value: the solver stores a length for a pair
-- of points, and has no way to hand a measurement back as a scalar. So this
-- form takes the length rather than returning it, and returns nothing.
-- `distance between p and q` as a *value* waits on the accessor work.

define distance between (p: Point) and (q: Point) is (d: Scalar) =
    tsx`
    segment(p, q)
    constrain({ kind: 'distance', p1: p, p2: q, value: d })
    `

-- ─── Making and naming ──────────────────────────────────────────────────────
-- Generic, and the reason no shape needs its own hatch. `new` makes an element
-- of any type, reaching down through that type's fields; `call` gives a second
-- name to something that already exists. Between them a composite is definable
-- in Tilde with no tsx of its own.
--
-- The type name sits in a `Name` slot because a `Name` slot is just "a bare
-- word" — declaring is what a body chooses to do with it, not what the slot
-- means. So `new Triangle t` needs no keyword.

define new (ty: Name) (n: Name) =
    tsx`
    mint(n, ty)
    `

define call (x: Any) (n: Name) =
    tsx`
    alias(n, x)
    `

-- ─── Drawn edges ────────────────────────────────────────────────────────────
-- A segment is a drawn join between two points, not a constraint.

define segment (p: Point) (q: Point) =
    tsx`
    segment(p, q)
    `
